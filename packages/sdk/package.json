{
  "name": "@validalo/sdk",
  "version": "1.0.0",
  "description": "Cliente de la API v1 de Valídalo para sistemas integradores (SRM, Marco, Portal u otro ERP), sandbox y verificador de webhooks. Sin dependencias; fetch y Web Crypto (Node 20+ o navegador).",
  "keywords": [
    "validalo",
    "sdk",
    "api",
    "webhooks",
    "sagrilaft",
    "validacion-documental",
    "proveedores"
  ],
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Valídalo",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    },
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../infra/sdk/preparar-npm.mjs",
    "verificar": "pnpm run build && node ../../infra/sdk/verificar-paquete.mjs",
    "typecheck": "tsc -p tsconfig.json"
  }
}

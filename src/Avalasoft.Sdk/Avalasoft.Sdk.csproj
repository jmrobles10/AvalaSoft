<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Empaquetado.props" />
  <!--
    SDK .NET para los sistemas que se integran con AvalaSoft (SRM, Marco, Portal u otro ERP): cliente tipado de la API v1,
    firma de aserciones de identidad delegada y verificación de webhooks (H9, docs/08 §2; CN-5). Sin dependencias fuera de la
    BCL. net7.0 porque el SRM corre .NET 7 (T-16).
  -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net7.0;net8.0;net10.0</TargetFrameworks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Avalasoft.Sdk</PackageId>
    <Description>Cliente .NET de la API v1 de AvalaSoft: vínculos, invitaciones, expedientes, certificados, consulta de certificación, eventos (pull), sandbox, identidad delegada y verificación de webhooks.</Description>
    <PackageTags>avalasoft;sdk;api;webhooks;sagrilaft;validacion-documental</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Avalasoft.Contratos\Avalasoft.Contratos.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Avalasoft.Sdk.Tests" />
  </ItemGroup>
</Project>
